# ElectroShop environment variables (placeholders only — copy to .env and fill in locally)
# Never commit .env with real secrets.
# Production connection strings: docs/CONNECTION_STRINGS.local.md (gitignored)

# --- Backend (ASP.NET Core / Render Web Service) ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:10000

# PostgreSQL (Docker local — port 5434)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5434;Database=ElectroShopDb;Username=postgres;Password=postgres

# Run EF Core migrations and seed on startup (local dev)
MIGRATE_ON_STARTUP=true
SEED_ON_STARTUP=true

# Comma-separated frontend origins for CORS (no trailing slashes)
FRONTEND_URLS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Public base URL for absolute image links in API responses (production: https://api.smartal.net)
PUBLIC_BASE_URL=https://api.smartal.net

# JWT (min 32 characters for Key)
JWT__Key=YOUR_JWT_SECRET_KEY_AT_LEAST_32_CHARACTERS
JWT__Issuer=ElectroShop
JWT__Audience=ElectroShop

# --- Frontend (Vite / Render Static Site) ---
VITE_API_BASE_URL=https://api.smartal.net/api
VITE_ASSET_BASE_URL=https://api.smartal.net
